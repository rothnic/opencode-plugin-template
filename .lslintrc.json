{
  "rules": {
    "directory-structure": {
      "required": [
        ".opencode",
        ".opencode/plugins",
        ".opencode/tools",
        ".opencode/agents",
        ".opencode/skills"
      ],
      "forbidden": []
    },
    "file-naming": {
      "patterns": {
        "*.ts": "kebab-case",
        "*.tsx": "PascalCase",
        "*.json": "kebab-case"
      }
    },
    "directory-naming": {
      "pattern": "kebab-case",
      "exceptions": [
        "node_modules",
        ".opencode",
        ".git"
      ]
    }
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "*.log"
  ]
}
